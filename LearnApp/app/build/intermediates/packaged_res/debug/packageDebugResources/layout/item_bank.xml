<?xml version="1.0" encoding="utf-8"?>
<!-- 题库列表项（微信对话项样式，支持左滑显示删除） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:background="@color/list_bg">

    <!-- 左滑露出的删除按钮 -->
    <TextView android:id="@+id/tvDeleteAction" android:layout_width="96dp"
        android:layout_height="match_parent" android:layout_gravity="end"
        android:background="@color/swipe_action"
        android:gravity="center" android:text="删除"
        android:textColor="#FFFFFF" android:textSize="15sp" />

    <!-- 主内容：滑动载体 -->
    <LinearLayout android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" android:gravity="center_vertical"
        android:background="@color/list_bg">

        <!-- 左侧 48dp 头像（微信用彩色方块或图片都可以） -->
        <ImageView android:id="@+id/ivAvatar" android:layout_width="48dp"
            android:layout_height="48dp" android:scaleType="centerCrop"
            android:background="@drawable/avatar_fallback" />

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:paddingHorizontal="12dp" android:gravity="center_vertical">

            <!-- 第一行：标题 + 右侧时间 -->
            <RelativeLayout android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:id="@+id/tvTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toLeftOf="@+id/tvTime"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/title_text"
                    android:textStyle="bold" />
                <TextView android:id="@+id/tvTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/text_time"
                    android:textSize="@dimen/time_text" />
            </RelativeLayout>

            <!-- 第二行：副标题 -->
            <TextView android:id="@+id/tvSubtitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/subtitle_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部 0.5dp 分割线 -->
    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:layout_gravity="bottom" android:layout_marginStart="76dp"
        android:background="@color/divider" />
</FrameLayout>

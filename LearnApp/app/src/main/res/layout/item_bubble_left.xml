<?xml version="1.0" encoding="utf-8"?>
<!-- 收到消息（左侧 bot 头像 + 昵称 + 白色气泡，气泡带小箭头指向头像） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingVertical="4dp">

    <ImageView android:id="@+id/ivAvatar" android:layout_width="@dimen/avatar_chat"
        android:layout_height="@dimen/avatar_chat" android:scaleType="centerCrop"
        android:background="@drawable/avatar_fallback" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/avatar_margin" android:orientation="vertical">
        <TextView android:id="@+id/nameLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="太上老君"
            android:textSize="11sp" android:textColor="@color/text_time"
            android:layout_marginTop="2dp" android:layout_marginBottom="2dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView android:layout_width="6dp" android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/bubble_arrow_left"
                android:contentDescription="气泡箭头" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvBubble"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="@dimen/bubble_max_w"
                android:background="@drawable/bubble_received"
                android:textColor="@color/chat_text_light"
                android:textSize="@dimen/chat_content_text"
                android:paddingHorizontal="@dimen/bubble_padding_h"
                android:paddingVertical="@dimen/bubble_padding_v" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
